# Copy to .env.staff.local. This template contains no credentials.
# Only BSTE Operations Staging values belong here. Do not copy production .env files.
BSTE_STAFF_ENV=staging
BSTE_STAFF_SUPABASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co
BSTE_STAFF_SUPABASE_PUBLIC_KEY=YOUR-STAGING-PUBLISHABLE-OR-ANON-PUBLIC-KEY
BSTE_STAFF_ORIGIN=https://localhost:3443
BSTE_STAFF_TLS_CERT_FILE=.local/staff-tls/localhost-cert.pem
BSTE_STAFF_TLS_KEY_FILE=.local/staff-tls/localhost-key.pem
# Preview deployment remains disabled; no Vercel settings are needed for local use.
